# --- Zorunlu ---
# Claude ücretini sizin hesabınız öder: https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...
# Yönetim paneli (/admin) parolası: en az 12 karakter, tahmin edilemez olsun
ADMIN_TOKEN=
# Veritabanının tutulacağı klasör (kalıcı disk). Yedek: bu klasördeki mimarnot.db
DATA_DIR=./data

# --- Gerçekçi render (isteğe bağlı; boşsa render kapalı) ---
HF_API_KEY_ID=
HF_API_KEY_SECRET=

# --- Havale/EFT bilgileri (Abone ol ekranında görünür) ---
PAY_BANK=
PAY_HOLDER=
PAY_IBAN=
CONTACT_EMAIL=
# Uluslararası biçimde, ör. 905321234567
CONTACT_WHATSAPP=

# --- Satıcı bilgileri (kullanım koşulları ve KVKK sayfalarında görünür) ---
COMPANY_NAME=
COMPANY_ADDRESS=

# --- İsteğe bağlı ---
# PORT=8080
# CLAUDE_MODEL=claude-opus-5-5
# Deneme: gün / üretim / render
# TRIAL_DAYS=7
# TRIAL_GENERATE=3
# TRIAL_RENDER=2
# Planları değiştirmek için (JSON dizi): [{"id":"baslangic","label":"Başlangıç","priceTry":990,"generate":25,"render":10,"features":["..."]}]
# PLANS_JSON=
